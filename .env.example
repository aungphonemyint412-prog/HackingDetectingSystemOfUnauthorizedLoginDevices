# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Flask secret key – change this to a long random string
SECRET_KEY=change-me-to-a-long-random-string

# Database
DATABASE_URL=sqlite:///hacking_detection.db

# Google OAuth (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Gmail SMTP credentials
# Use a Gmail App Password (not your main Gmail password).
# Enable 2-Step Verification at myaccount.google.com, then:
#   Security > App passwords > generate a 16-char password
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-16-char-app-password
